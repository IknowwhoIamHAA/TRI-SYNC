{
  "id": "basic",
  "description": "Single-tenant workflow: set a few state keys and delete one.",
  "steps": [
    {
      "id": "init",
      "tenant": "tenant-a",
      "ops": [
        { "op": "set", "key": "status", "value": "queued" },
        { "op": "set", "key": "retries", "value": "0" }
      ]
    },
    {
      "id": "start",
      "tenant": "tenant-a",
      "ops": [
        { "op": "set",    "key": "status",  "value": "running" },
        { "op": "add",    "key": "retries", "operand": 1.0 }
      ]
    },
    {
      "id": "finish",
      "tenant": "tenant-a",
      "ops": [
        { "op": "set",    "key": "status",  "value": "done" },
        { "op": "delete", "key": "retries" }
      ]
    }
  ]
}
