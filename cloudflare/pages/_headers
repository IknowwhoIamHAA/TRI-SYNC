/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'unsafe-inline' https://js.stripe.com; style-src 'unsafe-inline'; connect-src * https://api.stripe.com; img-src 'self' data: https://*.stripe.com; font-src 'self'; frame-src https://js.stripe.com https://hooks.stripe.com;
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
